VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (used by api/analyze-attempt.js) — no VITE_ prefix, so
# Vite never bundles this into the client. Get a free key at
# https://aistudio.google.com/apikey, and never put a payment method on that
# Google project unless you deliberately want billing enabled.
GEMINI_API_KEY=your-gemini-api-key
# Optional — defaults to gemini-3.6-flash if unset.
# GEMINI_MODEL=gemini-3.6-flash

# Web Push (used by api/notify-new-mock.js and src/lib/pushNotifications.js)
# — a keypair generated once with `npx web-push generate-vapid-keys`, not an
# external account/service. The public key is also needed client-side
# (VITE_ prefix, safe to expose — it's public by design), the private key
# must only ever live server-side.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Any mailto: address — required by the Web Push protocol so push services
# can contact you if they need to (e.g. abuse reports), not shown to users.
VAPID_CONTACT_EMAIL=mailto:you@example.com
